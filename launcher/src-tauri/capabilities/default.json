{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capability for KASCompute Launcher",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "kascompute-node", "sidecar": true },
        { "name": "kascompute-miner", "sidecar": true }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        { "name": "kascompute-node", "sidecar": true },
        { "name": "kascompute-miner", "sidecar": true }
      ]
    }
  ]
}
